EXT = .dll
# Prerequisites: Visual Studio Build Tools with the C++ workload.
YEAR = 2026
SQLITE_VERSION = 3530400

SQLITE_SOURCE_URL = https://sqlite.org/$(YEAR)/sqlite-src-$(SQLITE_VERSION).zip
SQLITE_SOURCE_PATH = deps\sqlite-src-$(SQLITE_VERSION)
SQLITE_AMALGAMATION_URL = https://sqlite.org/$(YEAR)/sqlite-amalgamation-$(SQLITE_VERSION).zip
SQLITE_AMALGAMATION_PATH = deps\sqlite-amalgamation-$(SQLITE_VERSION)

TCL_DOWNLOAD_URL = https://www.irontcl.com/downloads/irontcl-amd64-8.6.7.zip
TCLSH_PATH = deps\IronTcl\bin\tclsh86t.exe

CFLAGS = -I$(SQLITE_AMALGAMATION_PATH) -I$(SQLITE_SOURCE_PATH)\ext\fts5 -Os -Wall

prefix=dist
$(prefix):
    if not exist $(prefix) mkdir $(prefix)

TARGET_LOADABLE=$(prefix)\better-trigram$(EXT)
TARGET_FTS5=$(prefix)\fts5$(EXT)
TARGET_LEMON=$(prefix)\lemon.exe

all: test loadable
loadable: $(TARGET_LOADABLE)

clean:
    if exist deps rmdir /S /Q deps
    if exist $(prefix) rmdir /S /Q $(prefix)
    if exist *.obj del *.obj

$(SQLITE_SOURCE_PATH):
    @echo Downloading SQLite source...
    powershell -NoProfile -Command "Invoke-WebRequest -Uri '$(SQLITE_SOURCE_URL)' -OutFile 'sqlite-src.zip'"
    @echo Extracting SQLite source...
    powershell -NoProfile -Command "if (-not (Test-Path 'deps')) { New-Item -ItemType Directory -Path 'deps' -Force | Out-Null }; Expand-Archive -Path 'sqlite-src.zip' -DestinationPath 'deps' -Force"
    del sqlite-src.zip

$(SQLITE_AMALGAMATION_PATH):
    @echo Downloading SQLite amalgamation...
    powershell -NoProfile -Command "Invoke-WebRequest -Uri '$(SQLITE_AMALGAMATION_URL)' -OutFile 'sqlite.zip'"
    @echo Extracting SQLite amalgamation...
    powershell -NoProfile -Command "if (-not (Test-Path 'deps')) { New-Item -ItemType Directory -Path 'deps' -Force | Out-Null }; Expand-Archive -Path 'sqlite.zip' -DestinationPath 'deps' -Force"
    del sqlite.zip

$(TCLSH_PATH):
    @echo Downloading Tcl/Tk...
    powershell -NoProfile -Command "Invoke-WebRequest -Uri '$(TCL_DOWNLOAD_URL)' -OutFile 'tcl.zip'"
    @echo Extracting Tcl/Tk...
    powershell -NoProfile -Command "if (-not (Test-Path 'deps')) { New-Item -ItemType Directory -Path 'deps' -Force | Out-Null }; Expand-Archive -Path 'tcl.zip' -DestinationPath 'deps' -Force"
    del tcl.zip

$(TARGET_LOADABLE): $(SQLITE_SOURCE_PATH) $(SQLITE_AMALGAMATION_PATH) $(prefix)
    cl $(CFLAGS) /MT /LD /Fe$@ better-trigram.c

$(TARGET_LEMON): $(SQLITE_SOURCE_PATH) $(prefix)
    cl /MT "$(SQLITE_SOURCE_PATH)\tool\lemon.c" /Fe$@
    copy "$(SQLITE_SOURCE_PATH)\tool\lempar.c" "$(prefix)\lempar.c"

$(TARGET_FTS5): $(TARGET_LEMON) $(TCLSH_PATH) $(SQLITE_SOURCE_PATH) $(SQLITE_AMALGAMATION_PATH) $(prefix)
    $(TARGET_LEMON) "$(SQLITE_SOURCE_PATH)\ext\fts5\fts5parse.y"
    powershell -NoProfile -Command "$$CWD = (Get-Location).Path; cd '$(SQLITE_SOURCE_PATH)\ext\fts5'; & \"$$CWD\$(TCLSH_PATH)\" \"$$CWD\$(SQLITE_SOURCE_PATH)\ext\fts5\tool\mkfts5c.tcl\""
    cl /DSQLITE_TEST $(CFLAGS) /MT /LD /Fe$(TARGET_FTS5) "$(SQLITE_SOURCE_PATH)\ext\fts5\fts5.c"

test: $(TARGET_FTS5) $(TARGET_LOADABLE)
    bun test
